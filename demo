    var se = Math.sqrt(a * (1 - a) / n + b * (1 - b) / n);
    var zz = se > 0 ? (b - a) / se : 0;
    var txt = 'Task-oriented collision rate is ' + (a * 100).toFixed(1) + '% versus ' + (b * 100).toFixed(1) + '% for uniform, a difference of ' + ((b - a) * 100).toFixed(1) + ' percentage points. ';
    if (Math.abs(zz) >= 1.96) txt += zz > 0 ? 'This gap is larger than the statistical noise.' : 'Uniform is actually better here, and the gap is larger than the statistical noise.';
    else txt += 'This gap is within statistical noise, so it does not show which policy is better. Try more runs.';
    txt += ' Target only collides in ' + (res.target.collision / n * 100).toFixed(1) + '% of runs, which shows the cost of leaving the obstacle unobserved.';
    $('verdict').textContent = txt;
    btn.disabled = false;
  });

  setPolicy('task'); newEp();
  if (reduced) $('bPlay').textContent = 'Resume';
  requestAnimationFrame(frame);
})();
</script>

