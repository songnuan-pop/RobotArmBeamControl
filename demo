      </section>
    </div>
  </div>

  <section class="panel" aria-label="Batch comparison">
    <div class="panel-head">
      <h2>Batch comparison: the same random scenarios, run once per policy</h2>
      <span class="meta">Uses the power, speed, ε and safety distance set above</span>
    </div>
    <div class="batch-row">
      <label for="nBatch">Runs per policy</label>
      <select id="nBatch"><option value="100">100</option><option value="200">200</option><option value="400" selected>400</option></select>
      <button type="button" class="btn primary" id="bBatch">Run comparison</button>
      <span class="meta" id="bProg"></span>
    </div>
    <div class="scroll" style="margin-top:12px">
      <table>
        <thead><tr><th>Policy</th><th>Grasp success</th><th>Collision rate (95% interval)</th><th>Mean time</th><th>Mean obstacle σ</th></tr></thead>
        <tbody id="bBody"><tr><td colspan="5" class="meta">Click "Run comparison" to generate results.</td></tr></tbody>
      </table>
    </div>
    <p class="verdict" id="verdict"></p>
  </section>

  <section class="panel">
    <details>
      <summary>How the model is built, and what it simplifies</summary>
      <div class="model">
        <div>
          <h3>Three steps per control cycle</h3>
          <ul>
            <li>Target and obstacle each use a [position, velocity] constant-velocity model. The arm's own position is treated as known. The x and y axes share one covariance P.</li>
            <li>Enumerate 11×6 pairs (s, ρ): s is the share of power given to the target, ρ is the RF share between the two modalities. For each pair, compute the one-step posterior covariance.</li>
            <li>Pick the pair with the lowest cost under the chosen policy, update the estimates with noisy measurements, then drive avoidance and grasping from the estimates.</li>
          </ul>
          <span class="f">P⁻¹_post = P⁻¹_pred + diag(i_pos, i_vel)</span>
          <p>RF position accuracy degrades with range, but RF also measures Doppler velocity. Acoustic works only within about 0.3 m, with fine position accuracy.</p>
        </div>
        <div>
          <h3>Task-oriented cost</h3>
          <span class="f">c(s,ρ) = Σ_e w_e·(P_pos + ¼P_vel) + 400·max(0, zσ_O − (d̂_O − d_safe))²</span>
          <p>w_e varies with the arm-to-target distance and with how close the obstacle is to the safety boundary. The last term is the penalty form of the chance constraint, and z is set by ε.</p>
          <h3 style="margin-top:12px">Simplifications versus the original derivation</h3>
          <ul>
            <li>Two scalars (s, ρ) replace the complex beam weights, so there is no constant-modulus constraint.</li>
            <li>w_e is a hand-designed weight, not the M_t from the LQG Riccati recursion.</li>
            <li>The chance constraint is a penalty term, and each step looks only one step ahead instead of optimizing over T steps.</li>
            <li>The controller is a potential-field method, not LQG.</li>
          </ul>
        </div>
      </div>
    </details>
  </section>
</div>

<script>
/* Toy model core: beam allocation + Kalman estimation + avoidance/grasp control.
   Per axis state [position, velocity]; covariance shared by x and y (isotropic). */
(function (root) {
  const DT = 0.05;
  const W = 2.0, H = 1.2;

  function rng(seed) {
    let a = seed >>> 0;
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function gauss(r) {
    let u = 0; while (u === 0) u = r();
    const v = r();
    return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
  }
  // upper-tail normal quantile, Abramowitz-Stegun 26.2.23
  function zq(eps) {
    const t = Math.sqrt(-2 * Math.log(eps));
    return t - (2.515517 + 0.802853 * t + 0.010328 * t * t) /
      (1 + 1.432788 * t + 0.189269 * t * t + 0.001308 * t * t * t);
  }

  // symmetric 2x2 as {a,b,c} = [[a,b],[b,c]]
  function inv2(P) { const d = P.a * P.c - P.b * P.b; return { a: P.c / d, b: -P.b / d, c: P.a / d }; }
  function predictCov(P, qa) {
    const d = DT;
    const a = P.a + 2 * d * P.b + d * d * P.c + qa * qa * Math.pow(d, 4) / 4;
    const b = P.b + d * P.c + qa * qa * Math.pow(d, 3) / 2;
    const c = P.c + qa * qa * d * d;
    return { a, b, c };
  }
  function postCov(P, ip, iv) {
    const I = inv2(P);
    return inv2({ a: I.a + ip, b: I.b, c: I.c + iv });
  }

  // Information delivered by (RF share rho, acoustic share 1-rho) at a given range with power p.
  function info(range, p, rho) {
    const prf = p * rho, pac = p * (1 - rho);
    const near = Math.exp(-Math.pow(range / 0.3, 2));          // acoustic is near-field only
    const ip = prf / (0.12 * 0.12 * (1 + Math.pow(range / 1.0, 2))) + pac * near / (0.012 * 0.012);
    const iv = prf / (0.2 * 0.2) + pac * near / (0.25 * 0.25); // RF Doppler gives velocity
    return [ip, iv];
  }

  const FLOOR = 0.04;
  function powers(s, Ptot) {
    return [Ptot * (FLOOR + (1 - 2 * FLOOR) * s), Ptot * (FLOOR + (1 - 2 * FLOOR) * (1 - s))];
  }

  const DEFAULTS = {
    policy: 'task', Ptot: 0.3, eps: 0.05, obsSpeed: 1.25, wOb: 100, wOs: 0.6, dSafe: 0.22, dCol: 0.10, maxT: 25
  };

  function makeEpisode(cfg, seed) {
    const r = rng(seed);
    const T0 = { x: 1.45 + 0.3 * r(), y: 0.5 + 0.45 * r() };
    const ang = r() * 2 * Math.PI;
    const tv = { x: 0.05 * Math.cos(ang), y: 0.05 * Math.sin(ang) };
    const ob = {
      cx: 0.8 + 0.15 * r(), cy: 0.55, ax: 0.3, ay: 0.42,
      wx: 0.9 + 0.2 * r(), wy: 0.7 + 0.2 * r(),
      px: 2 * Math.PI * r(), py: 2 * Math.PI * r()
    };
    const ep = {
      cfg, r, t: 0, done: null, steps: 0,
      q: { x: 0.2, y: 0.15 }, v: { x: 0, y: 0 },
      T: { x: T0.x, y: T0.y, vx: tv.x, vy: tv.y }, ob,
      O: { x: 0, y: 0, vx: 0, vy: 0 },
      eT: { x: T0.x + 0.25 * gauss(r), y: T0.y + 0.25 * gauss(r), vx: 0, vy: 0 },
      eO: { x: 1.0, y: 0.6, vx: 0, vy: 0 },
      PT: { a: 0.3 * 0.3, b: 0, c: 0.1 * 0.1 },
      PO: { a: 0.4 * 0.4, b: 0, c: 0.3 * 0.3 },
      beam: { s: 0.5, rho: 0.5 }, hist: [],
      minDist: 9, sumSigO: 0, sumSigT: 0, n: 0
    };
    obstacleAt(ep, 0);
    return ep;
  }

  function obstacleAt(ep, t) {
    const o = ep.ob, k = ep.cfg.obsSpeed, tt = t * k;
    ep.O.x = o.cx + o.ax * Math.cos(o.wx * tt + o.px);
    ep.O.y = o.cy + o.ay * Math.sin(o.wy * tt + o.py);
    ep.O.vx = -o.ax * o.wx * k * Math.sin(o.wx * tt + o.px);
    ep.O.vy = o.ay * o.wy * k * Math.cos(o.wy * tt + o.py);
  }

  function chooseBeam(ep, PTp, POp) {
    const cfg = ep.cfg, q = ep.q;
    if (cfg.policy === 'uniform') return { s: 0.5, rho: 0.5 };
    if (cfg.policy === 'target') return { s: 1, rho: 0.5 };
    const rT = Math.hypot(ep.eT.x - q.x, ep.eT.y - q.y);
    const rO = Math.hypot(ep.eO.x - q.x, ep.eO.y - q.y);
    const z = zq(cfg.eps);
    const wT = 150 * (1 + 3 * Math.exp(-rT / 0.25));
    const margin = rO - cfg.dSafe;
    const gate = 1 / Math.pow(Math.max(margin / (cfg.wOs || 0.3), 0.15), 2);
    const wO = (cfg.wOb || 30) * gate;
    let best = null, bestC = Infinity;
    for (let i = 0; i <= 10; i++) {
      const s = i / 10;
      const [pT, pO] = powers(s, cfg.Ptot);
      for (let j = 0; j <= 5; j++) {
        const rho = j / 5;
        const [ipT, ivT] = info(rT, pT, rho);
        const [ipO, ivO] = info(rO, pO, rho);
        const A = postCov(PTp, ipT, ivT), B = postCov(POp, ipO, ivO);
        let c;
        if (cfg.policy === 'trace') {
          c = A.a + A.c + B.a + B.c;
        } else { // task oriented: Tr(M P) + chance-constraint penalty
          c = wT * (A.a + 0.25 * A.c) + wO * (B.a + 0.25 * B.c);
          const viol = Math.max(0, z * Math.sqrt(B.a) - margin);
          c += 400 * viol * viol;
        }
        if (c < bestC) { bestC = c; best = { s, rho }; }
      }
    }
    return best;
  }

  function control(ep) {
    const cfg = ep.cfg, q = ep.q, vmax = 0.4;
    const z = zq(cfg.eps);
