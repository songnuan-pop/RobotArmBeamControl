<div class="wrap">
  <header>
    <h1>Beam-Control Loop Simulator</h1>
    <p class="sub">A robot arm senses a target and one moving obstacle with RF and acoustic beams. Each control cycle it allocates beam power, estimates the state, then decides its motion. Switch policies to see how power allocation, estimation uncertainty and safety margin change.</p>
  </header>

  <div class="main">
    <div class="col">
      <section class="panel" aria-label="Simulation scene">
        <div class="panel-head">
          <h2>Workbench, top view</h2>
          <span class="meta">2.0 m × 1.2 m, one step per 0.05 s</span>
        </div>
        <canvas id="scene" role="img" aria-label="Top-view animation of the arm, target, obstacle and beams"></canvas>
        <div class="legend">
          <span><i class="chip" style="background:var(--grip)"></i>Arm</span>
          <span><i class="chip" style="background:var(--tgt)"></i>Target</span>
          <span><i class="chip" style="background:var(--obs)"></i>Obstacle</span>
          <span style="color:var(--rf)"><i class="chip" style="background:var(--rf)"></i>RF beam (wide, long range)</span>
          <span style="color:var(--ac)"><i class="chip" style="background:var(--ac)"></i>Acoustic beam (narrow, near field)</span>
          <span><i class="chip ring"></i>Uncertainty radius zσ of the estimate</span>
          <span><i class="chip dot"></i>Safety distance</span>
        </div>
      </section>

      <section class="panel" aria-label="Time series">
        <div class="charts">
          <div class="chart-box">
            <h2>Power allocation</h2>
            <div class="meta">
              <span><i class="chip" style="background:var(--tgt)"></i>Share to target</span>
              <span><i class="chip" style="background:var(--rf)"></i>RF share</span>
            </div>
            <canvas id="c1"></canvas>
          </div>
          <div class="chart-box">
            <h2>Estimate uncertainty (1σ, cm)</h2>
            <div class="meta">
              <span><i class="chip" style="background:var(--tgt)"></i>Target</span>
              <span><i class="chip" style="background:var(--obs)"></i>Obstacle</span>
            </div>
            <canvas id="c2"></canvas>
          </div>
          <div class="chart-box">
            <h2>Obstacle safety margin (cm)</h2>
            <div class="meta">
              <span><i class="chip" style="background:var(--ink)"></i>True distance − d_safe</span>
              <span><i class="chip" style="background:var(--obs)"></i>zσ</span>
            </div>
            <canvas id="c3"></canvas>
          </div>
        </div>
      </section>
    </div>

    <div class="col">
      <section class="panel" aria-label="Controls">
        <div class="panel-head"><h2>Beam policy</h2></div>
        <div class="seg" id="policy">
          <button type="button" data-p="task" aria-pressed="true">Task-oriented</button>
          <button type="button" data-p="trace" aria-pressed="false">Min trace</button>
          <button type="button" data-p="uniform" aria-pressed="false">Uniform</button>
          <button type="button" data-p="target" aria-pressed="false">Target only</button>
        </div>
        <p class="desc" id="pdesc"></p>

        <div class="field"><label for="sP">Total sensing power</label><output id="oP"></output>
          <input type="range" id="sP" min="0.1" max="1" step="0.05" value="0.3"></div>
        <div class="field"><label for="sV">Obstacle speed</label><output id="oV"></output>
          <input type="range" id="sV" min="0.5" max="1.8" step="0.05" value="1.25"></div>
        <div class="field"><label for="sE">Collision risk limit ε</label><output id="oE"></output>
          <input type="range" id="sE" min="0.01" max="0.2" step="0.01" value="0.05"></div>
        <div class="field"><label for="sD">Safety distance d_safe</label><output id="oD"></output>
          <input type="range" id="sD" min="15" max="35" step="1" value="22"></div>

        <div class="btns">
          <button type="button" class="btn primary" id="bPlay">Pause</button>
          <button type="button" class="btn" id="bStep">Step</button>
          <button type="button" class="btn" id="bNew">New run</button>
          <button type="button" class="btn" id="bSpeed">Speed 1×</button>
        </div>
      </section>

      <section class="panel" aria-label="Live readout">
        <div class="panel-head"><h2>Live readout</h2></div>
        <dl class="read" aria-live="off">
          <dt>Status</dt><dd id="rS" aria-live="polite">—</dd>
          <dt>Time</dt><dd id="rT">—</dd>
          <dt>Power to target s</dt><dd id="rs">—</dd>
          <dt>RF share ρ</dt><dd id="rr">—</dd>
          <dt>Target σ</dt><dd id="rsT">—</dd>
          <dt>Obstacle σ</dt><dd id="rsO">—</dd>
          <dt>Obstacle distance</dt><dd id="rdO">—</dd>
          <dt>Target distance</dt><dd id="rdT">—</dd>
